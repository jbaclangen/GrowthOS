# Copy to .env.local and fill in. Never commit real values.

# --- Supabase (Dashboard → Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SECRET_KEY=

# --- AI routing ---
# free = OpenRouter free models (MVP); paid = production lineup in src/lib/ai/router.ts
AI_MODE=free
OPENROUTER_API_KEY=

# --- n8n (workflow execution layer) ---
N8N_BASE_URL=
N8N_API_KEY=
# Shared secret n8n sends back on callbacks to /api/n8n/*
N8N_WEBHOOK_SECRET=

# --- Google (PageSpeed Insights, later GA4) ---
GOOGLE_API_KEY=

# --- Google Search Console connection (Pro; optional) ---
# OAuth 2.0 "Web application" client in the GCP project. Authorized redirect URIs:
#   https://app.braventa.io/api/integrations/google/callback
#   http://localhost:3000/api/integrations/google/callback
# Steps: docs/architecture/SEARCH_CONSOLE_SETUP.md. Left empty, Settings says the connection isn't set up yet.
GOOGLE_OAUTH_CLIENT_ID=
# Server-only.
GOOGLE_OAUTH_CLIENT_SECRET=
# Server-only. 32 random bytes, base64; encrypts stored refresh tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it makes existing connections unreadable, so owners would have to reconnect.
INTEGRATIONS_ENCRYPTION_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server-only, optional (at least 32 characters). Signs the hand-off between analysis steps (/api/jobs/continue).
# When unset, a key is derived from SUPABASE_SECRET_KEY. Analysis steps call NEXT_PUBLIC_APP_URL, so it must be the
# deployment's own public URL.
JOB_CONTINUE_SECRET=
