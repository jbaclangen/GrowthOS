# Copy to .env.local and fill in. Never commit real values.

# --- Supabase (Dashboard → Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SECRET_KEY=

# --- AI routing ---
OPENROUTER_API_KEY=

# --- n8n (workflow execution layer) ---
N8N_BASE_URL=
N8N_API_KEY=
# Shared secret n8n sends back on callbacks to /api/n8n/*
N8N_WEBHOOK_SECRET=

# --- Google (PageSpeed Insights, later GA4 / Search Console) ---
GOOGLE_API_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
