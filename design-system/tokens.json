    "icon": {
      "$value": "22.9%",
      "$description": "App icon tile corner (11/48)"
    },
    "pill": {
      "$value": "9999px",
      "$description": "Marketing CTAs, status pills"
    }
  },
  "shadow": {
    "$type": "shadow",
    "$description": "Elevation is mostly borders. Shadows only for things that float above the page.",
    "sm": {
      "$value": "0 1px 2px rgb(11 12 16 / 0.06)"
    },
    "md": {
      "$value": "0 4px 12px -2px rgb(11 12 16 / 0.10), 0 2px 4px -2px rgb(11 12 16 / 0.06)"
    },
    "lg": {
      "$value": "0 16px 40px -8px rgb(11 12 16 / 0.18)"
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": "120ms",
        "$description": "Hover, press, colour changes"
      },
      "base": {
        "$value": "200ms",
        "$description": "Menus, popovers, small reveals"
      },
      "slow": {
        "$value": "320ms",
        "$description": "Panels, page-level transitions"
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": "cubic-bezier(0.2, 0, 0, 1)"
      },
      "enter": {
        "$value": "cubic-bezier(0, 0, 0.2, 1)"
      },
      "exit": {
        "$value": "cubic-bezier(0.4, 0, 1, 1)"
      }
    }
  },
  "layout": {
    "$type": "dimension",
    "content-narrow": {
      "$value": "36rem",
      "$description": "Forms, auth, onboarding"
    },
    "content": {
      "$value": "64rem",
      "$description": "App pages"
    },
    "content-wide": {
      "$value": "80rem",
      "$description": "Marketing sections"
    },
    "gutter": {
      "$value": "16px",
      "$description": "Minimum side gutter on mobile"
    },
    "header-height": {
      "$value": "56px"
    }
  },
  "fontWeight": {
    "$type": "fontWeight",
    "body": {
      "$value": 400,
      "$description": "Comfortaa body"
    },
    "ui": {
      "$value": 600,
      "$description": "Comfortaa labels, buttons, emphasis"
    },
    "heading": {
      "$value": 700,
      "$description": "Quicksand headings and wordmark"
    }
  }
}
