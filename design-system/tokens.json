  "font": {
    "$type": "fontFamily",
    "display": {
      "$value": "var(--font-quicksand), 'Varela Round', ui-rounded, system-ui, sans-serif",
      "$description": "Quicksand (variable 300–700). Headings and the wordmark (founder decision D-015)."
    },
    "sans": {
      "$value": "var(--font-comfortaa), ui-rounded, system-ui, sans-serif",
      "$description": "Comfortaa (variable 300–700). All other text: body, UI, labels, chips (D-015)."
    },
    "mono": {
      "$value": "ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace",
      "$description": "System monospace. Code and IDs only, where fixed-width is functional — not a brand face."
    }
  },
  "fontSize": {
    "$type": "dimension",
    "$description": "Matches Tailwind's default scale. Comfortaa runs wide with a small x-height, so body copy is never set below text-sm (14px) and long-form reading uses text-base. 'display' is marketing only.",
    "xs": {
      "$value": "0.75rem",
      "lineHeight": "1rem"
    },
    "sm": {
      "$value": "0.875rem",
      "lineHeight": "1.25rem"
    },
    "base": {
      "$value": "1rem",
      "lineHeight": "1.5rem"
    },
    "lg": {
      "$value": "1.125rem",
      "lineHeight": "1.75rem"
    },
    "xl": {
      "$value": "1.25rem",
      "lineHeight": "1.75rem"
    },
    "2xl": {
      "$value": "1.5rem",
      "lineHeight": "2rem"
    },
    "3xl": {
      "$value": "1.875rem",
      "lineHeight": "2.25rem"
    },
    "4xl": {
      "$value": "2.25rem",
      "lineHeight": "2.5rem"
    },
    "5xl": {
      "$value": "3rem",
      "lineHeight": "1.05"
    },
    "6xl": {
      "$value": "3.75rem",
      "lineHeight": "1"
    },
    "display": {
      "$value": "clamp(2.75rem, 7vw, 5rem)",
      "lineHeight": "0.95"
    }
  },
  "tracking": {
    "$type": "dimension",
    "tight": {
      "$value": "-0.01em",
      "$description": "Quicksand headings"
    },
    "normal": {
      "$value": "0em"
    },
    "label": {
      "$value": "0.08em",
      "$description": "Uppercase Comfortaa eyebrows and chips"
    },
    "display": {
      "$value": "-0.015em",
      "$description": "Large Quicksand marketing headlines"
    }
  },
