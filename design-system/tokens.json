        "$description": "Primary light canvas. Slightly warm."
      },
      "cobalt": {
        "$value": "#2340F5",
        "$description": "Action colour: primary buttons, links, focus, selection. 6.7:1 on white."
      },
      "volt": {
        "$value": "#D4F53C",
        "$description": "Signal colour: the logo's next-action node, highlights on dark. Never text on light, never a semantic state."
      }
    },
