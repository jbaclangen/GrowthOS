    "32": {
      "$value": "128px"
    },
    "$type": "dimension",
    "$description": "4px base. Tailwind's default spacing scale (p-1 = 4px) already implements this; listed here as the contract."
  },
  "radius": {
    "$type": "dimension",
    "sm": {
      "$value": "4px",
      "$description": "Chips, small tags"
    },
    "md": {
      "$value": "8px",
      "$description": "Buttons, inputs"
    },
    "lg": {
      "$value": "12px",
      "$description": "Cards, panels"
