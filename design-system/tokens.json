        "$value": "{color.volt.400}"
      },
      "signal-foreground": {
        "$value": "{color.ink.950}"
      },
      "focus": {
        "$value": "{color.cobalt.400}"
      },
      "logo-node": {
        "$value": "{color.brand.volt}",
        "$description": "Waypoint node: Volt on dark"
      },
      "success": {
        "$value": "{color.green.400}"
      },
      "success-soft": {
        "$value": "{color.green.950}"
      },
      "warning": {
        "$value": "{color.amber.400}"
      },
      "warning-soft": {
        "$value": "{color.amber.950}"
