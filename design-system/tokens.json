  "theme": {
    "$description": "Semantic colour roles. Components use these, never raw palette values. Keys become CSS variables (--background, --accent, ...) and Tailwind colours (bg-background, text-accent, ...).",
    "light": {
      "background": {
        "$value": "{color.ink.50}",
        "$description": "Page canvas"
      },
      "surface": {
        "$value": "{color.ink.0}",
        "$description": "Cards, panels, inputs"
      },
      "surface-muted": {
        "$value": "{color.ink.100}",
        "$description": "Wells, tags, table stripes"
      },
      "foreground": {
        "$value": "{color.ink.950}"
      },
      "muted": {
        "$value": "{color.ink.500}",
        "$description": "Secondary text. ≥4.5:1 on background, surface and surface-muted."
      },
      "border": {
        "$value": "{color.ink.150}"
      },
      "border-strong": {
        "$value": "{color.ink.200}"
      },
      "accent": {
        "$value": "{color.cobalt.600}",
        "$description": "Primary action fill and link text"
      },
      "accent-hover": {
        "$value": "{color.cobalt.700}"
      },
      "accent-foreground": {
        "$value": "{color.ink.0}",
        "$description": "Text on accent fill"
      },
      "accent-soft": {
        "$value": "{color.cobalt.50}"
      },
      "accent-soft-foreground": {
        "$value": "{color.cobalt.700}"
      },
      "signal": {
        "$value": "{color.volt.400}",
        "$description": "Brand highlight; on light use only as a fill behind ink text"
      },
      "signal-foreground": {
        "$value": "{color.ink.950}"
      },
      "focus": {
        "$value": "{color.cobalt.500}"
      },
      "logo-node": {
        "$value": "{color.brand.cobalt}",
        "$description": "Waypoint node: Cobalt on light (Volt is invisible on Paper)"
      },
      "success": {
        "$value": "{color.green.700}"
      },
      "success-soft": {
        "$value": "{color.green.50}"
      },
      "warning": {
        "$value": "{color.amber.700}"
      },
      "warning-soft": {
        "$value": "{color.amber.50}"
      },
      "danger": {
        "$value": "{color.red.700}"
      },
      "danger-soft": {
        "$value": "{color.red.50}"
      },
      "info": {
        "$value": "{color.cobalt.700}"
      },
      "info-soft": {
        "$value": "{color.cobalt.50}"
      }
    },
    "dark": {
      "background": {
        "$value": "{color.ink.950}"
      },
      "surface": {
        "$value": "{color.ink.900}"
      },
      "surface-muted": {
        "$value": "{color.ink.850}"
      },
      "foreground": {
        "$value": "#F1F1EE"
